<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Lost & Found</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LostAndFoundPlatform.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                Lost<span class="brand-accent">&Found</span>
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav me-auto ms-lg-4">

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Item" ? "active" : "")"
                           asp-controller="Item"
                           asp-action="Index">
                            Items
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")"
                           asp-controller="Report"
                           asp-action="Index">
                            Reports
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Location" ? "active" : "")"
                           asp-controller="Location"
                           asp-action="Index">
                            Locations
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
                           asp-controller="Category"
                           asp-action="Index">
                            Categories
                        </a>
                    </li>

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Message" ? "active" : "")"
                               asp-controller="Message"
                               asp-action="MyMessages">
                                My Messages
                            </a>
                        </li>
                    }

                </ul>

                <div class="navbar-auth">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>
    </nav>
</header>


<main class="flex-grow-1">
    <div class="container py-4">
        @RenderBody()
    </div>
</main>


<footer class="site-footer mt-auto">

    <div class="container">

        <div class="footer-content">

            <div>
                <strong>Lost & Found</strong>

                <span>
                    Helping people reconnect with their belongings.
                </span>
            </div>


            <div class="footer-links">

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy Policy
                </a>

                <a asp-controller="Report"
                   asp-action="Index">
                    Reports
                </a>

            </div>

        </div>


        <div class="footer-bottom">
            © 2026 Lost & Found Platform
        </div>

    </div>

</footer>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>