@model LostAndFoundPlatform.Models.Report

@{
    ViewData["Title"] = "Create Report";
}

<div class="form-page">

    <div class="form-header">
        <span class="section-label">NEW REPORT</span>

        <h1>Create a Report</h1>

        @if (ViewBag.LockItem == true)
        {
            <p>
                Tell us whether
                <strong>@ViewBag.LockedItemName</strong>
                was lost or found and add the relevant location.
            </p>
        }
        else
        {
            <p>
                Select an item and provide the details
                for the Lost or Found report.
            </p>
        }
    </div>


    <div class="form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <!-- LOST / FOUND -->

            <div class="mb-4">

                <label class="form-label">
                    Report Type
                </label>

                <div class="report-type-options">

                    <label class="report-type-option lost-option">

                        <input type="radio"
                               asp-for="Type"
                               value="0" />

                        <div>
                            <strong>Lost</strong>
                            <span>I lost this item</span>
                        </div>

                    </label>


                    <label class="report-type-option found-option">

                        <input type="radio"
                               asp-for="Type"
                               value="1" />

                        <div>
                            <strong>Found</strong>
                            <span>I found this item</span>
                        </div>

                    </label>

                </div>

                <span asp-validation-for="Type"
                      class="text-danger">
                </span>

            </div>


            <!-- ITEM -->

            <div class="mb-4">

                <label class="form-label">
                    Item
                </label>

                @if (ViewBag.LockItem == true)
                {
                    <div class="selected-report-item">

                        <div>
                            <span class="selected-item-label">
                                Creating report for
                            </span>

                            <strong>
                                @ViewBag.LockedItemName
                            </strong>
                        </div>

                        <span class="selected-item-check">
                            ✓
                        </span>

                    </div>

                    <input type="hidden"
                           asp-for="ItemId"
                           value="@ViewBag.LockedItemId" />

                    <input type="hidden"
                           name="lockItem"
                           value="true" />
                }
                else
                {
                    <select asp-for="ItemId"
                            class="form-select"
                            asp-items="ViewBag.ItemId">

                        <option value="">
                            Select an item
                        </option>

                    </select>
                }

                <span asp-validation-for="ItemId"
                      class="text-danger">
                </span>

            </div>


            <!-- EVENT LOCATION -->

            <div class="mb-4">

                <label class="form-label">
                    Event Location
                </label>

                <select asp-for="EventLocationId"
                        class="form-select"
                        asp-items="ViewBag.EventLocationId">

                    <option value="">
                        Select a location
                    </option>

                </select>

                <span class="form-help">
                    Where the item was lost or found.
                </span>

                <span asp-validation-for="EventLocationId"
                      class="text-danger">
                </span>

            </div>


            <!-- PICKUP LOCATION -->

            <div class="mb-4">

                <label class="form-label">
                    Pickup Location
                </label>

                <select asp-for="PickupLocationId"
                        class="form-select"
                        asp-items="ViewBag.PickupLocationId">

                    <option value="">
                        No pickup location
                    </option>

                </select>

                <span class="form-help">
                    Mainly used for Found reports. Leave empty if not applicable.
                </span>

                <span asp-validation-for="PickupLocationId"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary">
                    Publish Report
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}