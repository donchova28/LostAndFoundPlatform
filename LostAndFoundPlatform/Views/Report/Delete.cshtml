@model LostAndFoundPlatform.Models.Report

@{
    ViewData["Title"] = "Delete Report";
}

<div class="delete-page">

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="back-link">
        ← Back to Report
    </a>

    <div class="delete-card">

        <div class="delete-icon">
            !
        </div>

        <span class="section-label">
            DELETE REPORT
        </span>

        <h1>
            Delete this report?
        </h1>

        <p class="delete-warning">
            Are you sure you want to delete this report?
            This action cannot be undone.
        </p>


        <div class="delete-report-summary">

            <div>
                <span>Type</span>

                @if (Model.Type == 0)
                {
                    <strong class="delete-status lost-text">
                        Lost
                    </strong>
                }
                else
                {
                    <strong class="delete-status found-text">
                        Found
                    </strong>
                }
            </div>


            <div>
                <span>Item</span>

                <strong>
                    @(Model.Item?.Name ?? "-")
                </strong>
            </div>


            <div>
                <span>Reported by</span>

                <strong>
                    @if (!string.IsNullOrWhiteSpace(Model.ApplicationUser?.FirstName) ||
                         !string.IsNullOrWhiteSpace(Model.ApplicationUser?.LastName))
                    {
                        @($"{Model.ApplicationUser?.FirstName} {Model.ApplicationUser?.LastName}")
                    }
                    else
                    {
                        @Model.ApplicationUser?.UserName
                    }
                </strong>
            </div>


            <div>
                <span>Event Location</span>

                <strong>
                    @if (Model.EventLocation != null)
                    {
                        @Model.EventLocation.Address

                        @if (!string.IsNullOrWhiteSpace(Model.EventLocation.City))
                        {
                            <text>, @Model.EventLocation.City</text>
                        }
                    }
                    else
                    {
                        <text>-</text>
                    }
                </strong>
            </div>


            <div>
                <span>Pickup Location</span>

                <strong>
                    @if (Model.PickupLocation != null)
                    {
                        @Model.PickupLocation.Address

                        @if (!string.IsNullOrWhiteSpace(Model.PickupLocation.City))
                        {
                            <text>, @Model.PickupLocation.City</text>
                        }
                    }
                    else
                    {
                        <text>-</text>
                    }
                </strong>
            </div>


            <div>
                <span>Created</span>

                <strong>
                    @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </strong>
            </div>

        </div>


        <div class="delete-danger-note">
            Deleting this report will also remove the messages
            associated with this report.
        </div>


        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="Id" />

            <div class="form-actions">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Report
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>