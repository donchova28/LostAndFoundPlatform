@model LostAndFoundPlatform.Models.Report

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Report</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Type
        </dt>
        <dd class="col-sm-10">
            @(Model.Type == 0 ? "Lost" : "Found")
        </dd>

        <dt class="col-sm-2">
            Created At
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedAt
        </dd>

        <dt class="col-sm-2">
            User
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.ApplicationUser?.FirstName) ||
                 !string.IsNullOrWhiteSpace(Model.ApplicationUser?.LastName))
            {
                <span>
                    @Model.ApplicationUser?.FirstName @Model.ApplicationUser?.LastName
                </span>
            }
            else
            {
                <span>@Model.ApplicationUser?.UserName</span>
            }
        </dd>

        <dt class="col-sm-2">
            Item
        </dt>
        <dd class="col-sm-10">
            @Model.Item?.Name
        </dd>

        <dt class="col-sm-2">
            Event Location
        </dt>
        <dd class="col-sm-10">
            @Model.EventLocation?.Address, @Model.EventLocation?.City
        </dd>

        <dt class="col-sm-2">
            Pickup Location
        </dt>
        <dd class="col-sm-10">
            @if (Model.PickupLocation != null &&
                 (!string.IsNullOrWhiteSpace(Model.PickupLocation.Address) ||
                  !string.IsNullOrWhiteSpace(Model.PickupLocation.City)))
            {
                @if (!string.IsNullOrWhiteSpace(Model.PickupLocation.Address))
                {
                    <span>@Model.PickupLocation.Address</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PickupLocation.Address) &&
                     !string.IsNullOrWhiteSpace(Model.PickupLocation.City))
                {
                    <span>, </span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.PickupLocation.City))
                {
                    <span>@Model.PickupLocation.City</span>
                }
            }
            else
            {
                <span>-</span>
            }
        </dd>

    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
