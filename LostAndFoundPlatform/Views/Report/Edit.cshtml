@model LostAndFoundPlatform.Models.Report

@{
    ViewData["Title"] = "Edit Report";
}

<div class="form-page">

    <div class="form-header">

        <span class="section-label">
            EDIT REPORT
        </span>

        <h1>Edit Report</h1>

        <p>
            Update the report information below.
        </p>

    </div>


    <div class="form-card">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>

            <input type="hidden"
                   asp-for="Id" />


            <!-- LOST / FOUND -->

            <div class="mb-4">

                <label class="form-label">
                    Report Type
                </label>

                <div class="report-type-options">

                    <label class="report-type-option lost-option">

                        <input type="radio"
                               asp-for="Type"
                               value="0" />

                        <div>
                            <strong>Lost</strong>
                            <span>I lost this item</span>
                        </div>

                    </label>


                    <label class="report-type-option found-option">

                        <input type="radio"
                               asp-for="Type"
                               value="1" />

                        <div>
                            <strong>Found</strong>
                            <span>I found this item</span>
                        </div>

                    </label>

                </div>

                <span asp-validation-for="Type"
                      class="text-danger">
                </span>

            </div>


            <!-- ITEM -->

            <div class="mb-4">

                <label class="form-label">
                    Item
                </label>

                <select asp-for="ItemId"
                        class="form-select"
                        asp-items="ViewBag.ItemId">
                </select>

                <span asp-validation-for="ItemId"
                      class="text-danger">
                </span>

            </div>


            <!-- EVENT LOCATION -->

            <div class="mb-4">

                <label class="form-label">
                    Event Location
                </label>

                <select asp-for="EventLocationId"
                        class="form-select"
                        asp-items="ViewBag.EventLocationId">
                </select>

                <span asp-validation-for="EventLocationId"
                      class="text-danger">
                </span>

            </div>


            <!-- PICKUP -->

            <div class="mb-4">

                <label class="form-label">
                    Pickup Location
                </label>

                <select asp-for="PickupLocationId"
                        class="form-select"
                        asp-items="ViewBag.PickupLocationId">

                    <option value="">
                        No pickup location
                    </option>

                </select>

                <span asp-validation-for="PickupLocationId"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}