@using System.Security.Claims
@model IEnumerable<LostAndFoundPlatform.Models.Report>

@{
    ViewData["Title"] = "Reports";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="page-header">

    <div>
        <span class="section-label">REPORTS</span>

        <h1>Lost & Found Reports</h1>

        <p class="text-muted mb-0">
            Browse reported lost and found items.
        </p>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + Create Report
        </a>
    }

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <div class="empty-state-icon">
            ?
        </div>

        <h3>No reports yet</h3>

        <p>
            There are currently no lost or found reports.
        </p>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var report in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="report-card">

                    <div class="report-card-image">

                        @if (!string.IsNullOrWhiteSpace(report.Item?.ImageUrl))
                        {
                            <img src="@report.Item.ImageUrl"
                                 alt="@report.Item.Name"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="report-image-placeholder"
                                 style="display:none;">
                                No image
                            </div>
                        }
                        else
                        {
                            <div class="report-image-placeholder">
                                No image
                            </div>
                        }


                        @if (report.Type == 0)
                        {
                            <span class="report-badge lost">
                                LOST
                            </span>
                        }
                        else
                        {
                            <span class="report-badge found">
                                FOUND
                            </span>
                        }

                    </div>


                    <div class="report-card-body">

                        <h3>
                            @(report.Item?.Name ?? "Unknown item")
                        </h3>


                        <div class="report-info">

                            <div>
                                <span class="report-info-label">
                                    Location
                                </span>

                                <span>
                                    @(report.EventLocation?.Address ?? "-")
                                </span>
                            </div>


                            <div>
                                <span class="report-info-label">
                                    Date
                                </span>

                                <span>
                                    @report.CreatedAt.ToString("dd.MM.yyyy")
                                </span>
                            </div>

                        </div>


                        <div class="report-card-actions">

                            <a asp-action="Details"
                               asp-route-id="@report.Id"
                               class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>

                            @if (report.ApplicationUserId == currentUserId)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@report.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@report.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}