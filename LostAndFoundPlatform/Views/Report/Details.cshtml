@model LostAndFoundPlatform.Models.Report

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Report</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Type
        </dt>
        <dd class="col-sm-10">
            @(Model.Type == 0 ? "Lost" : "Found")
        </dd>

        <dt class="col-sm-2">
            Created At
        </dt>
        <dd class="col-sm-10">
            @Model.CreatedAt
        </dd>

        <dt class="col-sm-2">
            User
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.ApplicationUser?.FirstName) ||
                 !string.IsNullOrWhiteSpace(Model.ApplicationUser?.LastName))
            {
                <span>@Model.ApplicationUser?.FirstName @Model.ApplicationUser?.LastName</span>
            }
            else
            {
                <span>@Model.ApplicationUser?.UserName</span>
            }
        </dd>

        <dt class="col-sm-2">
            Item
        </dt>
        <dd class="col-sm-10">
            @Model.Item?.Name
        </dd>

        <dt class="col-sm-2">
            Event Location
        </dt>
        <dd class="col-sm-10">
            @Model.EventLocation?.Address, @Model.EventLocation?.City
        </dd>

        <dt class="col-sm-2">
            Pickup Location
        </dt>
        <dd class="col-sm-10">
            @if (Model.PickupLocation != null)
            {
                <span>
                    @Model.PickupLocation.Address, @Model.PickupLocation.City
                </span>
            }
            else
            {
                <span>-</span>
            }
        </dd>

    </dl>
</div>

<div>
    @if (User.Identity != null &&
         User.Identity.IsAuthenticated &&
         User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.ApplicationUserId)  // proveruva dali najaveniot korisnik ne e sopstvenik na reportot
    {
        <a asp-controller="Message"
           asp-action="Chat"
           asp-route-reportId="@Model.Id"
           class="btn btn-primary">
            Contact Owner
        </a>
    }
</div>


<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
