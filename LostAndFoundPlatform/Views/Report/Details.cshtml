@using System.Security.Claims
@model LostAndFoundPlatform.Models.Report

@{
    ViewData["Title"] = "Report Details";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="report-details-page">

    <a asp-action="Index"
       class="back-link">
        ← Back to Reports
    </a>


    <div class="report-details-card">

        <div class="row g-0">

            <div class="col-lg-5">

                <div class="report-details-image-wrapper">

                    @if (!string.IsNullOrWhiteSpace(Model.Item?.ImageUrl))
                    {
                        <img src="@Model.Item.ImageUrl"
                             alt="@Model.Item.Name"
                             class="report-details-image"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                        <div class="details-image-placeholder"
                             style="display:none;">
                            No image available
                        </div>
                    }
                    else
                    {
                        <div class="details-image-placeholder">
                            No image available
                        </div>
                    }

                </div>

            </div>


            <div class="col-lg-7">

                <div class="report-details-content">

                    @if (Model.Type == 0)
                    {
                        <span class="report-status-badge lost">
                            LOST
                        </span>
                    }
                    else
                    {
                        <span class="report-status-badge found">
                            FOUND
                        </span>
                    }


                    <h1>
                        @(Model.Item?.Name ?? "Item")
                    </h1>


                    <p class="report-description">
                        @Model.Item?.Description
                    </p>


                    <div class="report-detail-list">

                        <div class="report-detail-row">
                            <span>Reported by</span>

                            <strong>
                                @if (!string.IsNullOrWhiteSpace(Model.ApplicationUser?.FirstName) ||
                                     !string.IsNullOrWhiteSpace(Model.ApplicationUser?.LastName))
                                {
                                    @($"{Model.ApplicationUser?.FirstName} {Model.ApplicationUser?.LastName}")
                                }
                                else
                                {
                                    @Model.ApplicationUser?.UserName
                                }
                            </strong>
                        </div>


                        <div class="report-detail-row">
                            <span>Report date</span>

                            <strong>
                                @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </strong>
                        </div>


                        <div class="report-detail-row">
                            <span>
                                @(Model.Type == 0
                                    ? "Last seen at"
                                    : "Found at")
                            </span>

                            <strong>
                                @if (Model.EventLocation != null)
                                {
                                    @Model.EventLocation.Address

                                    @if (!string.IsNullOrWhiteSpace(Model.EventLocation.City))
                                    {
                                        <text>, @Model.EventLocation.City</text>
                                    }
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </strong>
                        </div>


                        @if (Model.Type == 1)
                        {
                            <div class="report-detail-row">
                                <span>Pickup location</span>

                                <strong>
                                    @if (Model.PickupLocation != null)
                                    {
                                        @Model.PickupLocation.Address

                                        @if (!string.IsNullOrWhiteSpace(Model.PickupLocation.City))
                                        {
                                            <text>, @Model.PickupLocation.City</text>
                                        }
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </strong>
                            </div>
                        }

                    </div>


                    <div class="report-details-actions">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             Model.ApplicationUserId != currentUserId)
                        {
                            <a asp-controller="Message"
                               asp-action="Chat"
                               asp-route-reportId="@Model.Id"
                               class="btn btn-primary">
                                Contact Owner
                            </a>
                        }


                        @if (Model.ApplicationUserId == currentUserId)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Edit Report
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-danger">
                                Delete Report
                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>