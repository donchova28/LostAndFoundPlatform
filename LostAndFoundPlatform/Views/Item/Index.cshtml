@using System.Security.Claims
@model IEnumerable<LostAndFoundPlatform.Models.Item>

@{
    ViewData["Title"] = "Items";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    bool mineOnly = ViewBag.MineOnly == true;
}

<div class="page-header">
    <div>
        <span class="section-label">ITEMS</span>
        <h1>Browse Items</h1>
        <p class="text-muted mb-0">
            Browse items added by users or manage your own items.
        </p>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + Add Item
        </a>
    }
</div>


<div class="items-toolbar">

    <div class="filter-buttons">

        <a asp-action="Index"
           asp-route-mineOnly="false"
           class="btn @(mineOnly ? "btn-outline-secondary" : "btn-primary")">
            All Items
        </a>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="Index"
               asp-route-mineOnly="true"
               class="btn @(mineOnly ? "btn-primary" : "btn-outline-secondary")">
                My Items
            </a>
        }

    </div>

    <span class="text-muted">
        @Model.Count() item(s)
    </span>

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <div class="empty-state-icon">
            ?
        </div>

        <h3>No items found</h3>

        @if (mineOnly)
        {
            <p>
                You haven't added any items yet.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Add your first item
            </a>
        }
        else
        {
            <p>
                There are currently no items to display.
            </p>
        }

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-lg-4">

                <div class="item-card">

                    <div class="item-image-wrapper">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 class="item-image"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="item-image-placeholder"
                                 style="display:none;">
                                No image
                            </div>
                        }
                        else
                        {
                            <div class="item-image-placeholder">
                                No image
                            </div>
                        }

                    </div>


                    <div class="item-card-body">

                        <span class="category-badge">
                            @(item.Category?.Name ?? "No category")
                        </span>

                        <h3 class="item-card-title">
                            @item.Name
                        </h3>

                        <p class="item-card-description">
                            @item.Description
                        </p>


                        <div class="item-card-actions">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Details
                            </a>

                            @if (item.ApplicationUserId == currentUserId)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}