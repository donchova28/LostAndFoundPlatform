@model LostAndFoundPlatform.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="simple-details-page">

    <a asp-action="Index"
       class="back-link">
        ← Back to Categories
    </a>


    <div class="simple-details-card">

        <div class="simple-details-icon">
            #
        </div>

        <span class="section-label">
            CATEGORY
        </span>

        <h1>
            @Model.Name
        </h1>


        <div class="simple-detail-list">

            <div>
                <span>Category Name</span>
                <strong>@Model.Name</strong>
            </div>

        </div>


        @if (User.IsInRole("Admin"))
        {
            <div class="form-actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit Category
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">
                    Delete
                </a>

            </div>
        }

    </div>

</div>