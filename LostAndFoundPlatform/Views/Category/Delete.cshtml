@model LostAndFoundPlatform.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-icon">
            !
        </div>

        <span class="section-label">
            DELETE CATEGORY
        </span>

        <h1>
            Delete @Model.Name?
        </h1>

        <p class="delete-warning">
            This category can only be deleted if it is not currently
            used by any item.
        </p>


        <div class="delete-item-summary">

            <div>
                <span>Category</span>
                <strong>@Model.Name</strong>
            </div>

        </div>


        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="Id" />

            <div class="form-actions">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Category
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>