@model LostAndFoundPlatform.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="form-page">

    <div class="form-header">

        <span class="section-label">
            NEW CATEGORY
        </span>

        <h1>Add a Category</h1>

        <p>
            Create a category that users can select when adding items.
        </p>

    </div>


    <div class="form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-4">

                <label asp-for="Name"
                       class="form-label">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="e.g. Electronics" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary">
                    Add Category
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}