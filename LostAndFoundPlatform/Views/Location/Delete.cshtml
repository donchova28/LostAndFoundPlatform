@model LostAndFoundPlatform.Models.Location

@{
    ViewData["Title"] = "Delete Location";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-icon">
            !
        </div>

        <span class="section-label">
            DELETE LOCATION
        </span>

        <h1>Delete this location?</h1>

        <p class="delete-warning">
            This location can only be deleted if it is not
            currently used in a report.
        </p>


        <div class="delete-item-summary">

            <div>
                <span>Address</span>
                <strong>@Model.Address</strong>
            </div>

            <div>
                <span>City</span>
                <strong>@Model.City</strong>
            </div>

        </div>


        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="Id" />

            <div class="form-actions">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Location
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>