@using System.Security.Claims
@model LostAndFoundPlatform.Models.Location

@{
    ViewData["Title"] = "Location Details";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="simple-details-page">

    <a asp-action="Index"
       class="back-link">
        ← Back to Locations
    </a>


    <div class="simple-details-card">

        <div class="simple-details-icon">
            📍
        </div>

        <span class="section-label">
            LOCATION
        </span>

        <h1>
            @Model.Address
        </h1>


        <div class="simple-detail-list">

            <div>
                <span>Address</span>
                <strong>@Model.Address</strong>
            </div>

            <div>
                <span>City</span>
                <strong>@Model.City</strong>
            </div>

        </div>


        @if (Model.ApplicationUserId == currentUserId)
        {
            <div class="form-actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit Location
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">
                    Delete
                </a>

            </div>
        }

    </div>

</div>