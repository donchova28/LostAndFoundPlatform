@model LostAndFoundPlatform.Models.Location

@{
    ViewData["Title"] = "Add Location";
}

<div class="form-page">

    <div class="form-header">

        <span class="section-label">
            NEW LOCATION
        </span>

        <h1>Add a Location</h1>

        <p>
            Add a location that can later be used
            in Lost or Found reports.
        </p>

    </div>


    <div class="form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-4">

                <label asp-for="Address"
                       class="form-label">
                    Address
                </label>

                <input asp-for="Address"
                       class="form-control"
                       placeholder="e.g. Partizanska 10" />

                <span asp-validation-for="Address"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-4">

                <label asp-for="City"
                       class="form-label">
                    City
                </label>

                <input asp-for="City"
                       class="form-control"
                       placeholder="e.g. Skopje" />

                <span asp-validation-for="City"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary">
                    Add Location
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}