@using System.Security.Claims
@model IEnumerable<LostAndFoundPlatform.Models.Location>

@{
    ViewData["Title"] = "Locations";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="page-header">

    <div>
        <span class="section-label">LOCATIONS</span>

        <h1>Locations</h1>

        <p class="text-muted mb-0">
            Locations used for lost, found and pickup information.
        </p>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + Add Location
        </a>
    }

</div>


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


@if (!Model.Any())
{
    <div class="empty-state">

        <div class="empty-state-icon">
            📍
        </div>

        <h3>No locations yet</h3>

        <p>
            Add a location to use it when creating a report.
        </p>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Location
        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var location in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="location-card">

                    <div class="location-icon">
                        📍
                    </div>

                    <div class="location-card-content">

                        <h3>
                            @location.Address
                        </h3>

                        <p>
                            @location.City
                        </p>


                        <div class="location-actions">

                            <a asp-action="Details"
                               asp-route-id="@location.Id"
                               class="btn btn-outline-primary btn-sm">
                                Details
                            </a>


                            @if (location.ApplicationUserId == currentUserId)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@location.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@location.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}