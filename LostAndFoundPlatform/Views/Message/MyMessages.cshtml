@model IEnumerable<LostAndFoundPlatform.Models.Message>

@{
    ViewData["Title"] = "My Messages";

    string currentUserId = ViewBag.CurrentUserId;
}

<div class="page-header">

    <div>
        <span class="section-label">MESSAGES</span>

        <h1>My Messages</h1>

        <p class="text-muted mb-0">
            Conversations about your lost and found items.
        </p>
    </div>

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <div class="empty-state-icon">
            💬
        </div>

        <h3>No messages yet</h3>

        <p>
            When you contact someone about an item,
            your conversations will appear here.
        </p>

        <a asp-controller="Report"
           asp-action="Index"
           class="btn btn-primary">
            Browse Reports
        </a>

    </div>
}
else
{
    <div class="conversations-list">

        @foreach (var conversation in Model
            .GroupBy(m => new
            {
                ReportId = m.ReportId,

                OtherUserId = m.SenderId == currentUserId
                    ? m.ReceiverId
                    : m.SenderId
            })
            .OrderByDescending(g => g.Max(m => m.SentAt)))
        {
            var lastMessage = conversation
                .OrderByDescending(m => m.SentAt)
                .ThenByDescending(m => m.Id)
                .First();

            var otherUser =
                lastMessage.SenderId == currentUserId
                    ? lastMessage.Receiver
                    : lastMessage.Sender;

            var otherUserName =
                !string.IsNullOrWhiteSpace(otherUser?.FirstName)
                    ? $"{otherUser.FirstName} {otherUser.LastName}"
                    : otherUser?.UserName ?? "User";

            var lastMessageSender =
                lastMessage.SenderId == currentUserId
                    ? "You"
                    : otherUserName;

            <div class="conversation-card">

                <div class="conversation-main">

                    <div class="conversation-avatar">
                        @otherUserName.Substring(0, 1).ToUpper()
                    </div>

                    <div class="conversation-content">

                        <div class="conversation-top">

                            <div>
                                <h3>
                                    @otherUserName
                                </h3>

                                <span class="conversation-item">
                                    About:
                                    <strong>
                                        @(lastMessage.Report?.Item?.Name ?? "Item")
                                    </strong>
                                </span>
                            </div>

                            <span class="conversation-time">
                                @lastMessage.SentAt.ToString("dd.MM.yyyy HH:mm")
                            </span>

                        </div>


                        <div class="conversation-bottom">

                            <p>
                                <strong>@lastMessageSender:</strong>
                                @lastMessage.Content
                            </p>

                            @if (lastMessage.Report?.Type == 0)
                            {
                                <span class="message-report-badge lost">
                                    LOST
                                </span>
                            }
                            else
                            {
                                <span class="message-report-badge found">
                                    FOUND
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <a asp-controller="Message"
                   asp-action="Chat"
                   asp-route-reportId="@lastMessage.ReportId"
                   asp-route-otherUserId="@conversation.Key.OtherUserId"
                   class="btn btn-outline-primary">
                    Open Chat
                </a>

            </div>
        }

    </div>
}