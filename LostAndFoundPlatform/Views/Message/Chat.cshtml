@model IEnumerable<LostAndFoundPlatform.Models.Message>

@{
    ViewData["Title"] = "Chat";

    var report =
        ViewBag.Report as LostAndFoundPlatform.Models.Report;

    string currentUserId =
        ViewBag.CurrentUserId;

    string receiverId =
        ViewBag.OtherUserId;


    var firstMessage = Model.FirstOrDefault();

    LostAndFoundPlatform.Models.ApplicationUser? otherUser = null;

    if (firstMessage != null)
    {
        otherUser =
            firstMessage.SenderId == currentUserId
                ? firstMessage.Receiver
                : firstMessage.Sender;
    }
    else if (report != null &&
             currentUserId != report.ApplicationUserId)
    {
        otherUser = report.ApplicationUser;
    }


    var otherUserName =
        !string.IsNullOrWhiteSpace(otherUser?.FirstName)
            ? $"{otherUser.FirstName} {otherUser.LastName}"
            : otherUser?.UserName ?? "User";
}


<div class="chat-page">

    <a asp-controller="Message"
       asp-action="MyMessages"
       class="back-link">
        ← Back to Messages
    </a>


    <div class="chat-card">

        <!-- CHAT HEADER -->

        <div class="chat-header">

            <div class="chat-user-info">

                <div class="conversation-avatar">
                    @otherUserName.Substring(0, 1).ToUpper()
                </div>

                <div>
                    <h2>
                        @otherUserName
                    </h2>

                    <span>
                        Conversation about
                        <strong>
                            @(report?.Item?.Name ?? "Item")
                        </strong>
                    </span>
                </div>

            </div>


            @if (report != null)
            {
                <div>

                    @if (report.Type == 0)
                    {
                        <span class="message-report-badge lost">
                            LOST
                        </span>
                    }
                    else
                    {
                        <span class="message-report-badge found">
                            FOUND
                        </span>
                    }

                </div>
            }

        </div>


        <!-- MESSAGES -->

        <div class="chat-messages">

            @if (!Model.Any())
            {
                <div class="chat-empty">

                    <p>
                        No messages yet.
                    </p>

                    <span>
                        Start the conversation below.
                    </span>

                </div>
            }
            else
            {
                @foreach (var message in Model)
                {
                    var isMine =
                        message.SenderId == currentUserId;

                    var senderName =
                        !string.IsNullOrWhiteSpace(message.Sender?.FirstName)
                            ? $"{message.Sender.FirstName} {message.Sender.LastName}"
                            : message.Sender?.UserName ?? "User";


                    <div class="chat-message-row @(isMine ? "mine" : "theirs")">

                        <div class="chat-message">

                            <span class="message-sender">
                                @(isMine ? "You" : senderName)
                            </span>

                            <div class="message-bubble">
                                @message.Content
                            </div>

                            <span class="message-time">
                                @message.SentAt.ToString("dd.MM.yyyy HH:mm")
                            </span>

                        </div>

                    </div>
                }
            }

        </div>


        <!-- SEND MESSAGE -->

        <div class="chat-compose">

            <form asp-action="Send"
                  method="post">

                <input type="hidden"
                       name="reportId"
                       value="@report?.Id" />

                <input type="hidden"
                       name="receiverId"
                       value="@receiverId" />


                <div class="chat-input-row">

                    <textarea name="content"
                              class="form-control"
                              rows="2"
                              placeholder="Write a message..."
                              required></textarea>

                    <button type="submit"
                            class="btn btn-primary">
                        Send
                    </button>

                </div>

            </form>

        </div>

    </div>


    @if (report != null)
    {
        <div class="chat-report-link">

            <a asp-controller="Report"
               asp-action="Details"
               asp-route-id="@report.Id">
                View Report →
            </a>

        </div>
    }

</div>